# Optional settings are set to their default value.
# Env names are derived from config keys: yagpdb.foo.bar -> YAGPDB_FOO_BAR

########## Core ##########

# https://support.discordapp.com/hc/en-us/articles/206346498-Where-can-I-find-my-User-Server-Message-ID-
YAGPDB_OWNER=Insert owner id here
# Comma separated, used in addition to YAGPDB_OWNER
YAGPDB_OWNERS=

# https://github.com/reactiflux/discord-irc/wiki/Creating-a-discord-bot-&-getting-a-token
YAGPDB_CLIENTID=Insert client id here
YAGPDB_CLIENTSECRET=Insert client secret here
# Don't forget to the include the word "Bot"
YAGPDB_BOTTOKEN=Bot token_here

# Host without the protocol, used by the webserver
YAGPDB_HOST=yagpdb.example.com

# Used by yagpdb's own https letsnencrypt integration, if you're not using something else (like the below)
YAGPDB_EMAIL=email@example.com

# Used by jrcs/letsencrypt-nginx-proxy-companion
VIRTUAL_HOST=yagpdb.example.com
LETSENCRYPT_HOST=yagpdb.example.com
LETSENCRYPT_EMAIL=mail@example.com

########## Postgres ##########

YAGPDB_PQHOST=db
YAGPDB_PQUSERNAME=yagpdb
YAGPDB_PQPASSWORD=postgres_password
YAGPDB_PQDB=yagpdb
# Note the spelling, the config key is yagdb.pq_max_conns
YAGDB_PQ_MAX_CONNS=3
# Skip schema initialization on startup
YAGPDB_NO_SCHEMA_INIT=false

########## Redis ##########

YAGPDB_REDIS=redis:6379
YAGPDB_REDIS_POOL_SIZE=10

########## Commands ##########

# Allow built-in commands to run through the command prefix. When off, only the
# bot mention and slash commands work. Custom commands are unaffected.
YAGPDB_ENABLE_PREFIX_COMMANDS=false
# Show the prefix command deprecation notice on the dashboard and in discord
YAGPDB_ENABLE_PREFIX_COMMANDS_WARNING=false
# Set typing status while running commands
YAGPDB_COMMANDS_TYPING=true

########## Discord API ##########

# Max concurrent outgoing requests to discord
YAGPDB_MAX_CCR=25
YAGPDB_DISABLE_KEEPALIVES=false
# Base URL to send discord API requests through instead of https://discord.com/
YAGPDB_DISCORD_PROXY=
# Proxy URL for outgoing http requests
YAGPDB_HTTP_PROXY=

########## Sharding ##########

YAGPDB_SHARDING_TOTAL_SHARDS=0
# Shards active on this host, ex: '1-10,25'
YAGPDB_SHARDING_ACTIVE_SHARDS=
# Run a fixed shard, mostly for testing. Format 'id,count', ex: '0,10'
YAGPDB_SHARDING_FIXED_CONFIG=
# Large bot sharding (for 200k+ guilds)
YAGPDB_LARGE_BOT_SHARDING=false
YAGPDB_SHARD_BUCKETS_PER_NODE=8
YAGPDB_SHARD_SHARD_BUCKET_SIZE=2
# If set, the bot runs in orchestration mode and connects to this address
YAGPDB_ORCHESTRATOR_ADDRESS=

########## Internal services ##########

YAGPDB_BOTREST_LISTEN_ADDRESS=127.0.0.1
YAGPDB_BOTREST_PORT_RANGE=5100-5999
YAGPDB_BGWORKER_HTTP_SERVER_ADDR=localhost:5004
YAGPDB_MQUEUE_MAX_CONCURRENT_SENDS=3
YAGPDB_PROM_LISTEN_ADDR=
YAGPDB_PROM_LISTEN_PORT_RANGE=6001-6100

########## Bot state and memory ##########

YAGPDB_STATE_REMOVE_OFFLINE_MEMBERS=true
# Attempt to free resources when the OS is running low on memory
YAGPDB_MEM_MONITOR_ENABLED=true

########## Web ##########

# Overridden by the -pa flag
YAGPDB_WEB_HTTP_ADDRESS=5000
YAGPDB_WEB_HTTPS_ADDRESS=5001
# Header carrying the real client ip when behind a reverse proxy
YAGPDB_WEB_REVERSE_PROXY_CLIENT_IP_HEADER=
YAGPDB_DISABLE_REQUEST_LOGGING=false
# Server ID used for live demo links
YAGPDB_WEB_DEMO_SERVER_ID=0
# Channel to pull announcements from for the control panel homepage
YAGPDB_ANNOUNCEMENTS_CHANNEL=0
# Google analytics id
YAGPDB_GA_ID=

# Ads
YAGPDB_AD_IMG_PATH=
YAGPDB_AD_LINK=
YAGPDB_AD_W=0
YAGPDB_AD_H=0
# Comma separated list of video paths in different formats
YAGPDB_AD_VIDEO_PATHS=
# Path to the ads.txt file
YAGPDB_ADS_ADS_TXT=

########## Logging and admin, not required ##########

# Send gateway connection events to a discord channel
YAGPDB_CONNEVT_CHANNEL=
# Send connection status to a discord channel
YAGPDB_CONNSTATUS_CHANNEL=
# Bot leaves joins to this channel
YAGPDB_BOTLEAVESJOINS=
# Channel that DMs reported by users are forwarded to
YAGPDB_DM_REPORT_CHANNEL=0

# Sentry DSN for error reporting
YAGPDB_SENTRY_DSN=
YAGPDB_ENABLE_ANALYTICS=false

# Members with YAGPDB_ADMIN_ROLE on YAGPDB_MAIN_SERVER become bot admins,
# YAGPDB_READONLY_ACCESS_ROLE gets global read only access to configs.
# All three need to be set for this to run.
YAGPDB_MAIN_SERVER=0
YAGPDB_ADMIN_ROLE=0
YAGPDB_READONLY_ACCESS_ROLE=0

########## Plugins, not required ##########

# Logs
YAGPDB_ENABLE_USERNAME_TRACKING=false

# Delete message logs older than 30 days
YAGPDB_ENABLE_MESSAGE_LOG_PURGE=true

# Server stats
YAGPDB_SERVERSTATS_DEPRECATED=false
YAGPDB_SERVERSTATS_DISABLE_COMPRESSION=false
YAGPDB_SERVERSTATS_DISABLE_NEW_COMPRESSION=false
# Any non-empty value returns empty charts
YAGPDB_SERVERSTATS_DISABLE_SERVERSTATS=

# Role commands
YAGPDB_ROLECOMMANDS_DISABLE_REACTION_REMOVAL_SINGLE_MODE=false

# Reddit
YAGPDB_REDDIT_CLIENTID=Reddit application clientid here
YAGPDB_REDDIT_CLIENTSECRET=Reddit application client secret here
YAGPDB_REDDIT_REDIRECT=Reddit redirect uri here
YAGPDB_REDDIT_REFRESHTOKEN=Reddit never-ending refreshtoken here (duration=permanent)
YAGPDB_REDDIT_DEVUSERNAME=Reddit Username for the account from which your reddit app is registered. example "yagpdb", do not include the /u/.
YAGPDB_REDDIT_FAST_MAX_POSTS_HOUR=60
YAGPDB_REDDIT_SLOW_MAX_POSTS_HOUR=120
# Any non-empty value disables the fast feed
YAGPDB_REDDIT_FAST_FEED_DISABLED=

# Youtube and other google apis credentials json file
GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json

# This will be used as the pubsubhubbub (websub) verify token when receiving callbacks on new video uploads
# if this gets leaked, people could spam feeds. Set it to a random string and never change it.
YAGPDB_YOUTUBE_VERIFY_TOKEN=
YAGPDB_YOUTUBE_RESUB_BATCH_SIZE=1
# Days to cache youtube video data
YAGPDB_YOUTUBE_VIDEO_CACHE_DURATION=1

# Client id and secret to poll live status for users
YAGPDB_TWITCH_CLIENTID=
YAGPDB_TWITCH_CLIENTSECRET=

# Verification, the plugin is disabled unless both are set
YAGPDB_GOOGLE_RECAPTCHA_SITE_KEY=
YAGPDB_GOOGLE_RECAPTCHA_SECRET=
# Record the IP a member verified from, to detect alts and ban evasion
YAGPDB_VERIFICATION_TRACK_IPS=false

# Safebrowsing
YAGPDB_GOOGLE_SAFEBROWSING_API_KEY=

########## Premium ##########

# If true enables premium for all servers the bot is in
YAGPDB_PREMIUM_ALL_GUILDS_PREMIUM=

# DM users when they receive premium slots
YAGPDB_PREMIUM_SEND_PATREON_DM=false

# Patreon, needs access token, client id and client secret
YAGPDB_PATREON_API_ACCESS_TOKEN=
YAGPDB_PATREON_API_REFRESH_TOKEN=
YAGPDB_PATREON_API_CLIENT_ID=
YAGPDB_PATREON_API_CLIENT_SECRET=
